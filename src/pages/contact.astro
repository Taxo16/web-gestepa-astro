---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contacto | GESTEPA Asesores',
};
---

<Layout metadata={metadata}>
  <HeroText 
    tagline="Contacto" 
    title="Estamos cerca de ti" 
    subtitle="Contamos con una amplia red de oficinas para ofrecerte el mejor servicio presencial, además de nuestro soporte digital."
  />

  <ContactUs
    id="form"
    title="Envíanos un mensaje"
    subtitle="Si lo prefieres, rellena este formulario y nuestro equipo te contactará lo antes posible."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Nombre',
        placeholder: 'Tu nombre o el de tu empresa',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Correo Electrónico',
        placeholder: 'ejemplo@correo.com',
      },
      {
        type: 'text',
        name: 'phone',
        label: 'Teléfono',
        placeholder: '600 000 000',
      },
    ]}
    textarea={{
      label: 'Mensaje',
      placeholder: 'Cuéntanos en qué podemos ayudarte...',
    }}
    disclaimer={{
      label:
        'Al enviar este formulario, aceptas nuestra política de privacidad para gestionar tu consulta.',
    }}
    description="Solemos responder en menos de 24h laborables."
    button="Enviar Consulta"
  />

  <Features2
    title="Nuestras Oficinas"
    subtitle="Encuentra tu delegación más cercana. Estaremos encantados de recibirte."
    columns={3}
    items={[
      {
        title: 'Estepa (Sede Central)',
        description: 'C/ Salvador Moreno Durán 26, Local A<br/>41560 Estepa (Sevilla)',
        icon: 'tabler:home',
        callToAction: {
            text: 'Ver en mapa',
            href: 'https://www.google.com/maps/search/?api=1&query=C/+Salvador+Moreno+Durán+26,+Estepa',
            target: '_blank',
            variant: 'link',
        }
      },
      {
        title: 'Badolatosa',
        description: 'Avenida de Cuba 74<br/>41570 Badolatosa (Sevilla)',
        icon: 'tabler:map-pin',
        callToAction: {
            text: 'Ver en mapa',
            href: 'https://www.google.com/maps/search/?api=1&query=Avenida+de+Cuba+74,+Badolatosa',
            target: '_blank',
            variant: 'link',
        }
      },
      {
        title: 'Málaga',
        description: 'Plaza Uncibay nº3, 2.8<br/>29008 Málaga',
        icon: 'tabler:map-pin',
        callToAction: {
            text: 'Ver en mapa',
            href: 'https://www.google.com/maps/search/?api=1&query=Plaza+Uncibay+3,+Málaga',
            target: '_blank',
            variant: 'link',
        }
      },
      {
        title: 'Sevilla (La Negrilla)',
        description: 'Pol. Ind. La Negrilla, C/ Encuadernación 36<br/>41016 Sevilla',
        icon: 'tabler:building-factory',
        callToAction: {
            text: 'Ver en mapa',
            href: 'https://www.google.com/maps/search/?api=1&query=Calle+Encuadernación+36,+Sevilla',
            target: '_blank',
            variant: 'link',
        }
      },
      {
        title: 'Sevilla (República Argentina)',
        description: 'Av. República Argentina 13, Accb<br/>41011 Sevilla',
        icon: 'tabler:building',
        callToAction: {
            text: 'Ver en mapa',
            href: 'https://www.google.com/maps/search/?api=1&query=Av.+República+Argentina+13,+Sevilla',
            target: '_blank',
            variant: 'link',
        }
      },
      {
        title: 'Atención Telefónica y Email',
        description: '📞 955 21 15 15<br/>✉️ recursos@gestepa.com',
        icon: 'tabler:headset',
        callToAction: {
            text: 'Llamar ahora',
            href: 'tel:955211515',
            variant: 'link',
        }
      },
    ]}
  />
</Layout>