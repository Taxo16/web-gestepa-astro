<script>
  // NUEVAS FRASES ESTRATÉGICAS B2B
  const phrases = [
    "SERVICIO INTEGRAL",
    "PARA EMPRESAS",
    "APOYO A ASESORÍAS",
    "AHORRO ENERGÉTICO"
  ];
  
  const typingSpeed = 100;
  const deletingSpeed = 50;
  const pauseTime = 2000;
  
  let typewriterTimeout = null;
  
  function initTypewriter() {
    // Limpiamos cualquier timeout anterior para evitar solapamientos
    if (typewriterTimeout) clearTimeout(typewriterTimeout);

    let currentPhraseIndex = 0;
    let currentCharIndex = 0;
    let isDeleting = false;
    
    // Obtenemos el elemento nuevo renderizado tras la transición
    const textElement = document.getElementById('typewriter-text');
    if (!textElement) return;

    function type() {
      // Volvemos a buscar el elemento por si la página ha cambiado
      const el = document.getElementById('typewriter-text');
      if (!el) return; // Si ya no está en el DOM, detenemos la animación

      const currentPhrase = phrases[currentPhraseIndex];
      
      if (isDeleting) {
        el.textContent = currentPhrase.substring(0, currentCharIndex - 1);
        currentCharIndex--;
      } else {
        el.textContent = currentPhrase.substring(0, currentCharIndex + 1);
        currentCharIndex++;
      }

      let typeSpeed = isDeleting ? deletingSpeed : typingSpeed;

      if (!isDeleting && currentCharIndex === currentPhrase.length) {
        typeSpeed = pauseTime;
        isDeleting = true;
      } else if (isDeleting && currentCharIndex === 0) {
        isDeleting = false;
        currentPhraseIndex = (currentPhraseIndex + 1) % phrases.length;
        typeSpeed = 500;
      }

      typewriterTimeout = setTimeout(type, typeSpeed);
    }

    typewriterTimeout = setTimeout(type, 1000);
  }

  // Escuchamos el evento astro:page-load en lugar de DOMContentLoaded
  // Esto hace que el script se vuelva a ejecutar al volver a la página
  document.addEventListener('astro:page-load', initTypewriter);
</script>
